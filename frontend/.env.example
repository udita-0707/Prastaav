# Institution name shown in the landing page footer.
VITE_INSTITUTION_NAME=Your University
# Show the "Try demo accounts" buttons on the sign-in page (mirrors the backend demo seed).
VITE_SHOW_DEMO_ACCOUNTS=true
# Base URL of the API. The default "/api" goes through the Vite dev proxy to http://localhost:8080.
VITE_API_BASE_URL=/api
