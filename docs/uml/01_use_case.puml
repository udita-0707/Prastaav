@startuml 01_use_case
!include _style.iuml
title Prastav - Use cases (M1 implemented, <<M2>> planned)
left to right direction
actor Student
actor Faculty
actor Coordinator

rectangle "Prastav" {
  usecase "Register / log in (JWT)" as UC1
  usecase "Create project with draft v1" as UC2
  usecase "Edit own draft" as UC3
  usecase "Submit / resubmit proposal" as UC4
  usecase "View feedback and history" as UC5
  usecase "Create revision vN+1" as UC6
  usecase "Assign faculty reviewer" as UC7
  usecase "Review latest submitted version\n(approve / request revision / reject)" as UC8
  usecase "View project timeline (API)" as UC9
  usecase "View all projects" as UC10

  usecase "Reassign reviewer" as M2a <<M2>>
  usecase "Receive in-app notifications" as M2b <<M2>>
  usecase "Compare two versions" as M2c <<M2>>
  usecase "Dashboard: counts and workload" as M2d <<M2>>
  usecase "Browse audit log with filters" as M2e <<M2>>
  usecase "Filter, search, paginate lists" as M2f <<M2>>
}

Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC9
Faculty --> UC1
Faculty --> UC8
Faculty --> UC5
Coordinator --> UC1
Coordinator --> UC7
Coordinator --> UC10
Coordinator --> UC9

Coordinator ..> M2a
Coordinator ..> M2d
Coordinator ..> M2e
Student ..> M2b
Faculty ..> M2b
Student ..> M2c
Faculty ..> M2c
Coordinator ..> M2f

legend right
  Solid: [M1 Implemented]
  Grey dashed <<M2>>: [M2 Planned]
endlegend
@enduml
