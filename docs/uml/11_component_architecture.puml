@startuml 11_component_architecture
!include _style.iuml
title Prastav - Component / architecture (modular monolith)

node "Browser" {
  component "prastav-frontend\n(React + TS, Vite, TanStack Query, Axios)" as FE
}

node "prastav-backend (Spring Boot 3, Java 17)" {
  component "Security\n(JwtAuthenticationFilter, SecurityConfig, @PreAuthorize)" as SEC
  package "web layer" {
    component "Controllers + DTO mappers\n(Auth, User, Project, Dashboard, Proposal, Review, Audit, Notification)\nGlobalExceptionHandler" as WEB
  }
  package "modules" {
    component "auth\n(UserService, AuthService, JwtService, EmailPolicy)" as AUTH
    component "project\n(ProjectService, ProjectStore, ProjectAccessPolicy,\nProjectHistoryService, DashboardService)" as PROJ
    component "proposal\n(ProposalService, ProposalVersionFactory, ProposalDiffService)" as PROP
    component "review\n(ReviewService, ReviewDecisionHandler x3)" as REV
    component "workflow\n(WorkflowService, ProjectState x6, ProjectStateFactory, AllowedActionsResolver)" as WF
    component "audit\n(AuditEventListener, AuditRecorder, AuditQueryService)" as AUD
    component "notification\n(NotificationListener, NotificationDispatcher, NotificationChannel x2, NotificationService)" as NOTIF
  }
  component "Spring Data JPA repositories" as REPO
  component "Flyway migrations" as FLY
}

database "PostgreSQL 16\n(docker-compose)" as DB

FE --> SEC : REST + Bearer JWT (/api, proxied by Vite)
SEC --> WEB
WEB --> AUTH
WEB --> PROJ
WEB --> PROP
WEB --> REV
WEB --> WF
WEB --> AUD
WEB --> NOTIF
REV --> WF : decision strategies
REV --> PROJ : ProjectStore, ProjectAccessPolicy
REV --> PROP : latest submitted version
REV --> AUTH : UserService
WF --> PROJ : ProjectStore
WF --> PROP : open draft
WF --> AUTH : UserService
PROP --> PROJ : ProjectStore, ProjectAccessPolicy
PROP --> WF : ProjectStateFactory
PROJ --> PROP : proposal versions
PROJ --> WF : AllowedActionsResolver
PROJ --> AUTH : UserService
PROJ --> REV : timeline reviews
PROJ --> AUD : timeline status changes
NOTIF --> PROJ : ProjectStore
NOTIF --> AUTH : UserService
WF ..> AUD : events
PROJ ..> AUD : events
PROP ..> AUD : events
REV ..> AUD : events
WF ..> NOTIF : events, after commit
REV ..> NOTIF : events, after commit
AUTH --> REPO
PROJ --> REPO
PROP --> REPO
REV --> REPO
AUD --> REPO
NOTIF --> REPO
REPO --> DB
FLY --> DB
@enduml
