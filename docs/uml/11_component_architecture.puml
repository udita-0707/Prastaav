@startuml 11_component_architecture
!include _style.iuml
title Prastav - Component / architecture (modular monolith)

node "Browser" {
  component "prastav-frontend\n(React + TS, Vite,\nTanStack Query, Axios)" as FE
}

node "prastav-backend (Spring Boot 3, Java 17)" {
  component "Security\n(JwtAuthenticationFilter,\nSecurityConfig, @PreAuthorize)" as SEC
  package "web layer" {
    component "Controllers + DTO mappers\n(Auth, User, Project, Dashboard,\nProposal, Review, Notification)" as WEB
    component "GlobalExceptionHandler" as GEH
  }
  package "modules" {
    component "auth\n(UserService, AuthService, JwtService)" as AUTH
    component "project\n(ProjectService, ProjectStore,\nProjectAccessPolicy, ProjectHistoryService,\nDashboardService)" as PROJ
    component "proposal\n(ProposalService,\nProposalVersionFactory)" as PROP
    component "review\n(ReviewService,\nReviewDecisionHandler x3)" as REV
    component "workflow\n(WorkflowService, ProjectState x6,\nProjectStateFactory)" as WF
    component "audit\n(AuditEventListener,\nAuditRecorder, AuditQueryService)" as AUD
    component "notification\n(NotificationListener,\nNotificationDispatcher, NotificationService)" as NOTIF
  }
  component "Spring Data JPA repositories" as REPO
  component "Flyway migrations" as FLY
}

database "PostgreSQL 16\n(docker-compose)" as DB

FE --> SEC : REST + Bearer JWT\n(/api, proxied by Vite)
SEC --> WEB
WEB --> AUTH
WEB --> PROJ
WEB --> PROP
WEB --> REV
WEB --> WF
WEB --> NOTIF
REV --> WF : decision strategies
PROJ --> PROP
PROP --> WF : ProjectStateFactory\n(allowed actions)
WF --> PROP : open draft
WF ..> AUD : domain events (Observer)
PROJ ..> AUD : events
PROP ..> AUD : events
REV ..> AUD : events
WF ..> NOTIF : events (after commit)
REV ..> NOTIF : events (after commit)
NOTIF --> PROJ : ProjectStore
NOTIF --> REPO
AUTH --> REPO
PROJ --> REPO
PROP --> REPO
REV --> REPO
AUD --> REPO
REPO --> DB
FLY --> DB
@enduml
