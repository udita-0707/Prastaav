@startuml 09_seq_m2_notification
!include _style.iuml
title Sequence - <<M2 Planned>> Notification on review decision
skinparam sequence {
  ParticipantBackgroundColor<<M2>> #EEEEEE
  ParticipantBorderColor<<M2>> #9E9E9E
  ParticipantFontColor<<M2>> #757575
  LifeLineBorderColor #9E9E9E
}
autonumber
participant "WorkflowService" as WS
participant "Spring event bus" as BUS
participant "AuditEventListener" as AEL
participant "NotificationListener" as NL <<M2>>
participant "NotificationService" as NS <<M2>>
participant "InAppNotificationChannel" as IN <<M2>>
participant "EmailNotificationChannel" as EM <<M2>>
actor Student

WS -> BUS : publish ProjectStatusChangedEvent\n(UNDER_REVIEW -> REVISION_REQUESTED)
BUS -> AEL : on(event) [M1, unchanged]
BUS -[#9E9E9E]-> NL : on(event)
NL -[#9E9E9E]-> NS : notify(owner, REVIEW_DECISION, message)
NS -[#9E9E9E]-> IN : send(notification)
IN -[#9E9E9E]-> IN : save notifications row (is_read=false)
NS -[#9E9E9E]-> EM : send(notification)
EM -[#9E9E9E]-> EM : stub: log only
Student -[#9E9E9E]-> NS : GET /api/notifications\nPATCH /api/notifications/{id}/read
note over WS, AEL : Nothing in the workflow changes:\nthe listener and channels are new classes (OCP).
@enduml
