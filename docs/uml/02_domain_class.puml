@startuml 02_domain_class
!include _style.iuml
title Prastav - Domain model (entities and value types)
hide empty members

interface "Persistable<UUID>" as Persistable {
  + isNew() : boolean
}

abstract class BaseEntity {
  - id : UUID
  - createdAt : Instant
  - newEntity : boolean
  + getId() : UUID
  + getCreatedAt() : Instant
  + isNew() : boolean
  + equals(other : Object) : boolean
  + hashCode() : int
}

class User {
  - name : String
  - email : String
  - passwordHash : String
  - role : Role
  - admissionYear : Integer
  - branch : String
  + {static} student(name : String, studentEmail : StudentEmail, passwordHash : String) : User
  + toActor() : Actor
  + getRole() : Role
}

class StudentEmail <<record>> {
  email : String
  admissionYear : int
  branch : String
}

enum Role {
  STUDENT
  FACULTY
  COORDINATOR
}

class Project {
  - title : String
  - description : String
  - techStack : String
  - teamMembers : String
  - owner : User
  - reviewer : User
  - status : ProjectStatus
  - version : Long
  - updatedAt : Instant
  + moveTo(next : ProjectStatus)
  + assignReviewer(faculty : User)
  + isOwnedBy(userId : UUID) : boolean
  + isReviewedBy(userId : UUID) : boolean
  + getVersion() : Long
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
  + isTerminal() : boolean
}

class ProposalVersion {
  - project : Project
  - versionNumber : int
  - problemStatement : String
  - objectives : String
  - methodology : String
  - expectedOutcome : String
  - timeline : String
  - referenceLink : String
  - state : ProposalVersionState
  - submittedAt : Instant
  - createdBy : UUID
  + updateContent(content : ProposalContent)
  + submit()
  + isDraft() : boolean
  + missingFields() : List<String>
  + isComplete() : boolean
  + content() : ProposalContent
}

enum ProposalVersionState {
  DRAFT
  SUBMITTED
}

class ProposalContent <<record>> {
  problemStatement : String
  objectives : String
  methodology : String
  expectedOutcome : String
  timeline : String
  referenceLink : String
  + {static} empty() : ProposalContent
}

class ProposalDiff <<record>> {
  fromVersion : int
  toVersion : int
  fields : List<FieldDiff>
}

class FieldDiff <<record>> {
  name : String
  fromValue : String
  toValue : String
  changed : boolean
}

class ProposalDiffService {
  + compare(projectId : UUID, fromVersion : int, toVersion : int, actor : Actor) : ProposalDiff
}

class Review {
  - project : Project
  - proposalVersion : ProposalVersion
  - reviewer : User
  - decision : ReviewDecision
  - comments : String
  + getDecision() : ReviewDecision
  + getProposalVersion() : ProposalVersion
}

enum ReviewDecision {
  APPROVE
  REQUEST_REVISION
  REJECT
}

class AuditLog {
  - projectId : UUID
  - actorId : UUID
  - action : AuditAction
  - fromStatus : ProjectStatus
  - toStatus : ProjectStatus
  - details : String
  + {static} builder() : AuditLog.Builder
}

class "AuditLog.Builder" as AuditLogBuilder {
  + projectId(projectId : UUID) : Builder
  + actorId(actorId : UUID) : Builder
  + action(action : AuditAction) : Builder
  + fromStatus(fromStatus : ProjectStatus) : Builder
  + toStatus(toStatus : ProjectStatus) : Builder
  + details(details : String) : Builder
  + build() : AuditLog
}

enum AuditAction {
  PROJECT_CREATED
  VERSION_CREATED
  DRAFT_UPDATED
  PROPOSAL_SUBMITTED
  REVIEWER_ASSIGNED
  REVIEWER_REASSIGNED
  REVIEW_RECORDED
  STATUS_CHANGED
}

class Notification {
  - recipient : User
  - project : Project
  - type : NotificationType
  - message : String
  - read : boolean
  + markRead()
  + isAddressedTo(userId : UUID) : boolean
  + isRead() : boolean
}

enum NotificationType {
  REVIEWER_ASSIGNED
  REVIEWER_UNASSIGNED
  REVIEW_DECISION
  RESUBMITTED
}

Persistable <|.. BaseEntity
BaseEntity <|-- User
BaseEntity <|-- Project
BaseEntity <|-- ProposalVersion
BaseEntity <|-- Review
BaseEntity <|-- AuditLog
BaseEntity <|-- Notification
Project "*" --> "1" User : owner
Project "*" --> "0..1" User : reviewer
Project "1" *-- "1..*" ProposalVersion : versions
Project "1" o-- "*" Review : reviews
Project "0..1" o-- "*" AuditLog : projectId
Review "*" --> "1" ProposalVersion : proposalVersion
Review "*" --> "1" User : reviewer
AuditLog "*" --> "1" User : actorId
ProposalVersion "*" --> "1" User : createdBy
Notification "*" --> "1" User : recipient
Notification "*" --> "0..1" Project : project
User "*" --> "1" Role : role
Project "*" --> "1" ProjectStatus : status
ProposalVersion "*" --> "1" ProposalVersionState : state
Review "*" --> "1" ReviewDecision : decision
AuditLog "*" --> "1" AuditAction : action
AuditLog "*" --> "0..2" ProjectStatus : fromStatus, toStatus
Notification "*" --> "1" NotificationType : type
ProposalDiff "1" *-- "6" FieldDiff : fields
User ..> StudentEmail : student()
ProposalVersion ..> ProposalContent : content()
ProposalDiffService ..> ProposalVersion : compares two
ProposalDiffService ..> ProposalDiff : creates
AuditLogBuilder ..> AuditLog : build()

note right of ProposalVersion
  Composition: a version is created with and for one project,
  and project_id is NOT NULL. Immutable once SUBMITTED.
end note

note right of AuditLog
  projectId and actorId are plain UUIDs, not JPA relations.
  A database trigger makes the table append-only.
end note
@enduml
