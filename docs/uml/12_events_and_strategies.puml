@startuml 12_events_and_strategies
!include _style.iuml
title Prastav - Observer (domain events and audit) and Strategy (review decisions)
hide empty members

class ProjectCreatedEvent <<record>> {
  projectId : UUID
  actorId : UUID
  title : String
}

class ProposalVersionCreatedEvent <<record>> {
  projectId : UUID
  versionNumber : int
  actorId : UUID
}

class ProposalDraftUpdatedEvent <<record>> {
  projectId : UUID
  versionNumber : int
  actorId : UUID
}

class ProjectStatusChangedEvent <<record>> {
  projectId : UUID
  actorId : UUID
  action : Action
  fromStatus : ProjectStatus
  toStatus : ProjectStatus
  details : Map<String, String>
}

class ReviewerReassignedEvent <<record>> {
  projectId : UUID
  actorId : UUID
  previousReviewerId : UUID
  newReviewerId : UUID
}

class ReviewRecordedEvent <<record>> {
  projectId : UUID
  reviewId : UUID
  versionNumber : int
  reviewerId : UUID
  decision : ReviewDecision
}

class AuditEventListener <<Observer>> {
  - recorder : AuditRecorder
  - objectMapper : ObjectMapper
  + on(event : ProjectCreatedEvent)
  + on(event : ProposalVersionCreatedEvent)
  + on(event : ProposalDraftUpdatedEvent)
  + on(event : ProjectStatusChangedEvent)
  + on(event : ReviewerReassignedEvent)
  + on(event : ReviewRecordedEvent)
}

interface AuditRecorder {
  + record(entry : AuditLog)
}

class JpaAuditRecorder {
  - auditLogRepository : AuditLogRepository
  + record(entry : AuditLog)
}

class NotificationListener <<Observer>> {
  + on(event : ProjectStatusChangedEvent)
  + on(event : ReviewerReassignedEvent)
  + on(event : ReviewRecordedEvent)
}

interface ReviewDecisionHandler <<Strategy>> {
  + decision() : ReviewDecision
  + apply(projectId : UUID, actor : Actor, comments : String)
}

class ApproveDecisionHandler {
  - workflowService : WorkflowService
}

class RequestRevisionDecisionHandler {
  - workflowService : WorkflowService
}

class RejectDecisionHandler {
  - workflowService : WorkflowService
}

class ReviewService {
  - handlers : Map<ReviewDecision, ReviewDecisionHandler>
  + recordReview(projectId : UUID, decision : ReviewDecision, comments : String, versionNumber : Integer, actor : Actor) : Review
  + listReviews(projectId : UUID, actor : Actor) : List<Review>
}

class WorkflowService <<Facade>> {
  + approve(projectId : UUID, actor : Actor) : Project
  + requestRevision(projectId : UUID, actor : Actor, comments : String) : Project
  + reject(projectId : UUID, actor : Actor, comments : String) : Project
}

AuditRecorder <|.. JpaAuditRecorder
AuditEventListener "1" --> "1" AuditRecorder : recorder
AuditEventListener ..> ProjectCreatedEvent
AuditEventListener ..> ProposalVersionCreatedEvent
AuditEventListener ..> ProposalDraftUpdatedEvent
AuditEventListener ..> ProjectStatusChangedEvent
AuditEventListener ..> ReviewerReassignedEvent
AuditEventListener ..> ReviewRecordedEvent
NotificationListener ..> ProjectStatusChangedEvent
NotificationListener ..> ReviewerReassignedEvent
NotificationListener ..> ReviewRecordedEvent
ReviewDecisionHandler <|.. ApproveDecisionHandler
ReviewDecisionHandler <|.. RequestRevisionDecisionHandler
ReviewDecisionHandler <|.. RejectDecisionHandler
ReviewService "1" o--> "3" ReviewDecisionHandler : handlers
ReviewService ..> ReviewRecordedEvent : publishes
ApproveDecisionHandler "1" --> "1" WorkflowService : approve()
RequestRevisionDecisionHandler "1" --> "1" WorkflowService : requestRevision()
RejectDecisionHandler "1" --> "1" WorkflowService : reject()

note right of AuditEventListener
  Runs in the publisher's transaction: a change
  and its audit row commit or roll back together.
end note

note right of NotificationListener
  Runs after commit. Each delivery has its own transaction.
  See the notification class and sequence diagrams.
end note
@enduml
