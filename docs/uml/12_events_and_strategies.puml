@startuml 12_events_and_strategies
!include _style.iuml
title Prastav - Observer (domain events), Strategy (review decisions, email policy, notification channels) and Decorator (retries)
hide empty members

package "Observer: events" {
  class ProjectCreatedEvent <<record>>
  class ProposalVersionCreatedEvent <<record>>
  class ProposalDraftUpdatedEvent <<record>>
  class ProjectStatusChangedEvent <<record>>
  class ReviewRecordedEvent <<record>>
  class ReviewerReassignedEvent <<record>>

  class AuditEventListener {
    - recorder : AuditRecorder
    - objectMapper : ObjectMapper
    + on(event : ProjectCreatedEvent)
    + on(event : ProposalVersionCreatedEvent)
    + on(event : ProposalDraftUpdatedEvent)
    + on(event : ProjectStatusChangedEvent)
    + on(event : ReviewerReassignedEvent)
    + on(event : ReviewRecordedEvent)
  }
  interface AuditRecorder {
    + record(entry : AuditLog)
  }
  class JpaAuditRecorder
  AuditRecorder <|.. JpaAuditRecorder
  AuditEventListener --> AuditRecorder
}

AuditEventListener ..> ProjectCreatedEvent
AuditEventListener ..> ProposalVersionCreatedEvent
AuditEventListener ..> ProposalDraftUpdatedEvent
AuditEventListener ..> ProjectStatusChangedEvent
AuditEventListener ..> ReviewRecordedEvent
AuditEventListener ..> ReviewerReassignedEvent

class NotificationListener {
  - projectStore : ProjectStore
  - userService : UserService
  - dispatcher : NotificationDispatcher
  + on(event : ProjectStatusChangedEvent)
  + on(event : ReviewerReassignedEvent)
  + on(event : ReviewRecordedEvent)
}
note right of NotificationListener
  @TransactionalEventListener (after commit)
  @Transactional(REQUIRES_NEW)
  ASSIGN_REVIEWER -> reviewer
  SUBMIT from REVISION_REQUESTED -> reviewer
  review decision -> owner
  reassignment -> previous and new reviewer
end note
NotificationListener ..> ProjectStatusChangedEvent
NotificationListener ..> ReviewRecordedEvent
NotificationListener ..> ReviewerReassignedEvent
NotificationListener --> NotificationDispatcher : dispatch()

package "Strategy: review decisions" {
  interface ReviewDecisionHandler {
    + decision() : ReviewDecision
    + apply(projectId : UUID, actor : Actor, comments : String)
  }
  class ApproveDecisionHandler
  class RequestRevisionDecisionHandler
  class RejectDecisionHandler
  ReviewDecisionHandler <|.. ApproveDecisionHandler
  ReviewDecisionHandler <|.. RequestRevisionDecisionHandler
  ReviewDecisionHandler <|.. RejectDecisionHandler

  class ReviewService {
    - handlers : Map<ReviewDecision, ReviewDecisionHandler>
    + recordReview(projectId, decision, comments, versionNumber, actor) : Review
    + listReviews(projectId : UUID, actor : Actor) : List<Review>
  }
  ReviewService o--> ReviewDecisionHandler
}

package "Strategy: institution email policy" {
  interface EmailPolicy {
    + requireInstitutional(email : String) : String
    + requireStudent(email : String) : StudentEmail
  }
  class PatternEmailPolicy
  EmailPolicy <|.. PatternEmailPolicy
  class AuthService {
    + register(name, email, password, role) : AuthResult
  }
  class UserService {
    + createAccount(actor, name, email, password, role) : User
  }
  AuthService --> EmailPolicy : requireStudent()
  UserService --> EmailPolicy : requireInstitutional()
}

package "Strategy and Decorator: notification channels" {
  interface NotificationChannel {
    + name() : String
    + deliver(notification : Notification)
  }
  class InAppNotificationChannel {
    - notificationService : NotificationService
  }
  class EmailNotificationChannel
  NotificationChannel <|.. InAppNotificationChannel
  NotificationChannel <|.. EmailNotificationChannel
  class RetryingNotificationChannel <<Decorator>> {
    - delegate : NotificationChannel
    - maxAttempts : int
    - delay : Duration
  }
  NotificationChannel <|.. RetryingNotificationChannel
  RetryingNotificationChannel o--> "1" NotificationChannel : delegate

  class NotificationDispatcher {
    - enabledChannels : List<NotificationChannel>
    + dispatch(notification : Notification)
  }
  class NotificationProperties <<record>> {
    + enabledChannels() : List<String>
    + retry() : Retry
  }
  NotificationDispatcher o--> RetryingNotificationChannel : wraps each enabled channel
  NotificationDispatcher ..> NotificationProperties : enabled-channels, retry
  class NotificationService {
    + create(recipient, project, type, message) : Notification
  }
  InAppNotificationChannel --> NotificationService : create()
}

class WorkflowService <<Facade>>
ApproveDecisionHandler --> WorkflowService : approve()
RequestRevisionDecisionHandler --> WorkflowService : requestRevision()
RejectDecisionHandler --> WorkflowService : reject()
ReviewService ..> ReviewRecordedEvent : publishes
@enduml
